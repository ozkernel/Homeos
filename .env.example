# HomeOS v2.0.0 image
HOMEOS_IMAGE=ghcr.io/ozkernel/homeos:2.0.0

# Host access; localhost-only by default. Set to 0.0.0.0 for trusted LAN access.
HOMEOS_BIND=127.0.0.1
HOMEOS_HOST_PORT=3080

# Leave bootstrap credentials empty to use the first-run setup flow.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD_FILE=

HOMEOS_DEMO=true
HOMEOS_LOCAL_BOOTSTRAP=false
HOMEOS_LOG_LEVEL=INFO
HOMEOS_SECURITY_LOGGING=true
HOMEOS_HTTPS_ONLY=false
HOMEOS_SHUTDOWN_MS=8000
HOMEOS_TRUSTED_PROXIES=
MYFILES_STORAGE_PATH=/app/data/myfiles
TZ=Australia/Melbourne

# Optional absolute host directory for the shared library.
# MYFILES_HOST_PATH=/mnt/user/appdata/homeos/myfiles